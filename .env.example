# ============================================================================
# Yahoo Finance News Intelligence Platform — example environment file
# Copy to `.env` and fill in real values.  NEVER commit the real .env.
# ============================================================================

# --- Database ---------------------------------------------------------------
# Docker Compose injects the internal Postgres URL automatically.
# Local dev default (no Docker): sqlite+aiosqlite:///./news_intel.db
DATABASE_URL=postgresql+asyncpg://news_user:change_me@postgres:5432/news_intel
DB_PASSWORD=change_me
REDIS_URL=redis://redis:6379/0

# --- LLM (OpenAI-compatible provider: NVIDIA NIM by default) ----------------
# NVIDIA NIM hosts an OpenAI-compatible endpoint. Any OpenAI-compatible
# provider works here (OpenAI, vLLM, Ollama, Together, Groq, ...):
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_BASE_URL=http://localhost:11434/v1        (Ollama)
#   LLM_BASE_URL=https://api.openai.com/v1        (OpenAI)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# One NVIDIA-hosted model per persona (pick any ids from build.nvidia.com/explore).
# All three may point at the same model if you prefer.
ANALYST_MODEL=meta/llama-3.3-70b-instruct
RISK_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
SWING_MODEL=qwen/qwen2.5-32b-instruct

# --- Scraper tuning (all optional, sensible defaults) -----------------------
# SCRAPER_INTERVAL_MINUTES=15
# SCRAPER_MAX_PAGES_SAFETY=50
# SCRAPER_BACKFILL_DAYS=2
# SCRAPER_RATE_LIMIT_MAX_REQUESTS=30
# SCRAPER_RATE_LIMIT_PERIOD_SECONDS=600
# SCRAPER_PLAYWRIGHT_FALLBACK_ENABLED=true
# SCRAPER_SELECTORS_FILE=scraper/selectors.yaml

# --- Analyzer tuning (all optional) -----------------------------------------
# ANALYSIS_INTERVAL_MINUTES=240
# ANALYSIS_LOOKBACK_HOURS=16
# ANALYSIS_MAX_ARTICLES_PER_TICKER=15
# ANALYSIS_MAX_CONCURRENT_LLM=5
